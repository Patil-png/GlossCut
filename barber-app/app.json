{
  "expo": {
    "name": "GlossCut Partner",
    "slug": "glosscut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/GlossCut.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.thakurthansen.barberapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow SetKarr to use FaceID to unlock the app.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow GlossCut Partner to access your camera to take profile and shop photos.",
        "NSPhotoLibraryUsageDescription": "Allow GlossCut Partner to access your photos to upload profile and shop images.",
        "NSPhotoLibraryAddUsageDescription": "Allow GlossCut Partner to save photos to your library.",
        "NSMicrophoneUsageDescription": "Allow GlossCut Partner to access your microphone for video recording and audio features.",
        "NSLocationWhenInUseUsageDescription": "Allow GlossCut Partner to access your location to show nearby shops and barbers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow GlossCut Partner to access your location even when the app is in the background to provide better services."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/GlossCut.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.thakurthansen.barberapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACzrII-6Y9GULrv9wYTlnWN2Sqhzi9_jQ"
        }
      },
      "useNextNotificationsApi": true,
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "notification": {
      "icon": "./assets/GlossCut.png",
      "color": "#231F7C"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "barberapp",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-local-authentication",
      "expo-secure-store",
      "react-native-compressor",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "shrinking": true,
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9627982c-5c56-4fe3-9733-5c96ee73c2e4"
      }
    }
  }
}