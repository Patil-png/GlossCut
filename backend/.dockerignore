# Ignore node_modules
node_modules/
.npm/

# Ignore WhatsApp Web data (HUGE)
.wwebjs_auth/
.wwebjs_cache/

# Ignore git and local environment files
.git
.gitignore
.env
.env.example
.gitattributes

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore temporary and test files
test_active.js
testSearch.js
test_featured_shops.js
reports/
benchmarks/
uploads/*
!uploads/.gitkeep

# Ignore OS and build files
.DS_Store
Thumbs.db
.well-known/

# Ignore potentially large/unwanted media in ONLY the root of backend
# But allow specific assets if needed
*.mp4
*.zip
*.tar.gz
*.pdf
# *.png, *.jpg, etc. are now allowed to support branding and assets
