# Ignore node_modules
node_modules/
.npm/

# Ignore WhatsApp Web data (HUGE)
.wwebjs_auth/
.wwebjs_cache/

# Ignore git and local environment files
.git
.gitignore
.env
.env.example
.gitattributes

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore temporary and test files
test_active.js
testSearch.js
test_featured_shops.js
reports/
benchmarks/
uploads/*
!uploads/.gitkeep

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore media files (huge impact on build context)
*.mp4
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.zip
*.tar.gz

# Coolify / Build Artifacts
.well-known/
