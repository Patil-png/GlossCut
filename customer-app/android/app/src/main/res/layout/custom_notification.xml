<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SetKarr • now"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Title (e.g. Arriving in 9 mins) -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle / Status -->
    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- Custom Progress Bar with the Sliding Character Thumb -->
    <SeekBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/custom_progress_track"
        android:thumb="@drawable/custom_barber_thumb"
        android:splitTrack="false"
        android:thumbOffset="0dp"
        android:enabled="false"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

    <!-- Beautiful Salon Night Road Illustration -->
    <ImageView
        android:id="@+id/road_illustration"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/salon_road" />

</LinearLayout>
